    },
    "During navigation, location updates the route and the round-display guidance, and continues with the screen locked or in another app. Ending navigation stops navigation location. You can change permissions in Settings." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante a navegação, a localização atualiza a rota e as instruções da tela redonda, e continua com a tela bloqueada ou em outro app. Encerrar a navegação desliga a localização da navegação. Você pode mudar as permissões nos Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导航期间，定位用于更新路线和圆屏指引；锁屏或切换应用后仍可继续。结束导航会停止导航定位。可在系统设置中调整权限。"
          }
        }
      }
    },
    "End navigation" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerrar navegação"
