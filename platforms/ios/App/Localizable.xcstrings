    },
    "End navigation before changing the gateway address." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerre a navegação antes de trocar o endereço do gateway."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先结束导航，再更换网关地址。"
