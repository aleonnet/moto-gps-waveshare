        }
      }
    },
    "Your location is unavailable right now. Move to an open area and try again." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua localização está indisponível agora. Vá para um lugar aberto e tente de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
