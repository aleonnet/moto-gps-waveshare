          "stringUnit" : {
            "state" : "translated",
            "value" : "先体验一次导航流程"
          }
        }
      }
    },
    "Turn on Bluetooth and allow MOTO GPS to use it." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o Bluetooth e permita que o MOTO GPS o use."
          }
