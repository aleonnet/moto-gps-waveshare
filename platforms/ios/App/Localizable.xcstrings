    "Your current location is needed to plan a route. Allow location in Settings." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua localização atual é necessária para planejar a rota. Permita a localização nos Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
