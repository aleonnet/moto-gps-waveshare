          }
        }
      }
    },
    "Turn on location in Settings" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar a localização nos Ajustes"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前往设置开启定位"
          }
        }
      }
    },
    "Type at least two characters, for example “Olympic Sports Center”." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite ao menos dois caracteres, por exemplo “Centro Olímpico”."
          }
