# Copy to .env (ignored by Git). Load explicitly with node --env-file=.env.
# disabled is safe for initial deployment; fixture is ONLY for local tests (recorded answers, no network).
# amap: AMap everywhere (unchanged). regional: AMap in mainland China, Geoapify everywhere else.
MOTO_PROVIDER=disabled
AMAP_WEB_SERVICE_KEY=
# regional mode: required; AMAP_WEB_SERVICE_KEY becomes optional (China requests fail closed without it).
GEOAPIFY_API_KEY=
# Region for a search with no rider position and no client country: global or china.
MOTO_DEFAULT_REGION=global
# Map source: auto (Protomaps PMTiles builds), protomaps-api (hosted API, needs the key), an HTTPS .pmtiles URL, or disabled.
# MOTO_MAP_PMTILES_URL=protomaps-api
PROTOMAPS_API_KEY=
PORT=8787
WEB_ORIGIN=http://127.0.0.1:4173
