# Copy to .dev.vars for LOCAL testing. Never commit a real key.
# fixture answers from recorded responses and does not contact AMap, Geoapify or Protomaps.
MOTO_PROVIDER=fixture
MOTO_MAP_PMTILES_URL=disabled
# For live LOCAL testing, use MOTO_PROVIDER=amap and add your own key:
# AMAP_WEB_SERVICE_KEY=
# Or MOTO_PROVIDER=regional (AMap in mainland China, Geoapify elsewhere):
# GEOAPIFY_API_KEY=
# MOTO_DEFAULT_REGION=global
# MOTO_MAP_PMTILES_URL=protomaps-api
# PROTOMAPS_API_KEY=
